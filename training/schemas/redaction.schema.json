{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DigitMed human-approved redaction record",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "reviewer_id", "reviewed_at", "regions", "approved_for_training"],
  "properties": {
    "sample_id": {"type": "string"},
    "reviewer_id": {"type": "string", "description": "Pseudonymous reviewer key"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "approved_for_training": {"type": "boolean"},
    "regions": {"type": "array", "items": {"type": "object", "required": ["x", "y", "width", "height", "reason"], "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "reason": {"enum": ["patient_identifier", "contact_detail", "address", "identifier", "other_phi"]}}}}
  }
}
